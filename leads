      ["6. Nile Delta Governorates","Sadat City (Menoufia)","Regina for Pasta & Food Industries","2nd Industrial Zone, Sadat City, Menoufia","Flour, Sugar, Rice & Pasta","Pasta Manufacturing & Durum Milling (18k+ MT/yr)","+20 48 260 0138","info@pastaregina.com",[0,1,0,0,1,1,0,0,0]],
      ["6. Nile Delta Governorates","Quesna (Menoufia)","Egypt Foods Group (Tiger)","Quesna Industrial Zone, Menoufia","Snacks, Confectionery & Dry Food","Potato Chips, Corn Snacks & Confectionery","+20 48 259 0050","Export Dept (FEC Registry)",[0,1,0,0,0,1,0,0,0]],
      ["6. Nile Delta Governorates","Kafr El Zayat (Gharbia)","Egyptian Financial & Industrial Co. (EFIC)","51 Ahmed Maher St., Kafr El Zayat (Office: New Cairo)","Fertilizers, Salt & Chemicals","Phosphate Fertilizers & Chemicals","040 254 2515 / +20 2 2813 8352","efic@efic-eg.com / solimanazab.ex@efic-eg.com",[0,1,0,0,0,0,0,0,0]],
      ["6. Nile Delta Governorates","Tanta (Gharbia)","Middle & West Delta Flour Mills","Tanta, Gharbia","Flour, Sugar, Rice & Pasta","Flour Milling, Pasta & Bakeries","+20 40 329 7952","middle_westflourmill@yahoo.com",[0,1,0,0,1,0,0,0,0]],
      ["6. Nile Delta Governorates","Desouk (Kafr El Sheikh)","Green Fields Dairy","El Mandora, Desouk, Kafr El Sheikh","Dairy & Cheese","Dairy & Cheese Processing","+20 100 215 8557","m.abdelhady@greenfields.com.eg",[0,0,0,0,0,1,1,0,0]],
      ["6. Nile Delta Governorates","Beheira","Albadr for Investments (Frozena)","Beheira Governorate","IQF Frozen & Agri Export","IQF Frozen Vegetables & Fruits","+20 45 355 2100 / 045 355 2101","FEC Registry",[0,1,0,1,0,1,0,0,0]],
      ["6. Nile Delta Governorates","Abou El Matamir (Beheira)","Abdelwahab Sons","Km 54 Alex-Cairo Desert Rd., Abou El Matamir","IQF Frozen & Agri Export","Citrus & Fresh Fruit Packhouse/Exporter","+20 100 319 8888 / +20 100 058 0602","abdelwahab.fruit@yahoo.com",[0,1,0,0,0,0,0,1,0]],

      // REGION 7: SUEZ CANAL & DAMIETTA HUBS (7)
      ["7. Suez Canal & Damietta","Suez (Attaqa)","Five Star Flour Mills Co. S.A.E.","Attaqa Industrial Zone, Gulf of Suez","Flour, Sugar, Rice & Pasta","Industrial Flour & Semolina Milling","+20 62 323 0552","fsfs@fivestar.com.eg / @fivestar.com.eg",[0,1,0,0,1,1,0,0,0]],
      ["7. Suez Canal & Damietta","Damietta","Misr Fertilizers Production Co. (MOPCO)","Plot 52 & 53A, Damietta Public Free Zone (HQ: New Cairo)","Fertilizers, Salt & Chemicals","Urea & Nitrogen Fertilizers","+20 57 229 2061 / +20 2 2673 1156","ceo@mopco-eg.com",[0,1,0,0,0,0,0,0,0]],
      ["7. Suez Canal & Damietta","New Damietta","Halayeb Co. for Dairy Products & Juice","Industrial Zone, New Damietta","Dairy & Cheese","White Cheese, Roumy Cheese, Dairy & Juice","+20 57 240 9911 / +20 57 240 9933","halayeb@halayeb.com",[0,0,0,0,0,1,1,1,0]],
      ["7. Suez Canal & Damietta","Damietta","Misr Italy for Pasta & Food Industries","Damietta Industrial Zone","Flour, Sugar, Rice & Pasta","Pasta & Macaroni Manufacturing","+20 57 240 9100","Export Dept (Mohammad Abdel Wahab)",[0,1,0,0,1,1,0,0,0]],
      ["7. Suez Canal & Damietta","Damietta","National Cooling & Freezing Co. (CAFCO)","Damietta","IQF Frozen & Agri Export","IQF Frozen Vegetables & Cold Storage","+20 57 366 1101 / +20 57 366 1202","FEC Registry",[0,1,0,1,0,1,0,0,0]],
      ["7. Suez Canal & Damietta","Port Said","Port Said Co. (Soudan Co.)","Industrial Zone, South Port Said, Block 50/51","Dairy & Cheese","Dairy & Food Processing","+20 100 347 9995 / +20 66 377 2074","howayda.darwish@soudanco.com",[0,0,0,0,0,1,1,0,0]],
      ["7. Suez Canal & Damietta","Ismailia (Serabium)","Ismailia Misr Poultry Co.","Suez Desert Rd., Serabium, Ismailia","Poultry, Meat & Seafood","Poultry Slaughtering (10M birds/yr), Eggs & Feed","+20 122 329 4086","ahmed.wafek@gmail.com",[0,1,0,1,0,0,0,0,1]],

      // REGION 8: FAYOUM & UPPER EGYPT (3)
      ["8. Fayoum & Upper Egypt","Fayoum (Abshway)","EMISAL (Egyptian Minerals & Salts Co.)","Shakshouk, Abshway, Fayoum (Cairo Office: Dokki)","Fertilizers, Salt & Chemicals","Edible Salt, Vacuum Salt & Sodium Sulfate (350k+ MT/yr)","01080852528 / 01002104119 / 02 3338 7663","sales@emisalsalts.com",[0,1,0,0,0,1,0,0,0]],
      ["8. Fayoum & Upper Egypt","Beni Suef","Angel Yeast Egypt Co. Ltd.","Beni Suef Industrial Zone","Snacks, Confectionery & Dry Food","Dry Yeast & Yeast Extract Manufacturing","Corporate Registry","gaolu@angelyeast.com / aie@angelyeast.com",[0,1,0,0,0,1,0,0,0]],
      ["8. Fayoum & Upper Egypt","Beni Suef","Upper Egypt for Food Industries (UEFFI)","Plots 239–242, Food Ind. Zone, Beni Suef (HQ: Heliopolis)","IQF Frozen & Agri Export","IQF Frozen Fruits & Vegetables","Corporate Registry","Portal (gulfood.com Exhibitor)",[0,1,0,1,0,1,0,0,0]]
    ];

    let filteredLeads = [...RAW_LEADS];

    const tbody = document.getElementById("leads-tbody");
    const searchEl = document.getElementById("filter-search");
    const regionEl = document.getElementById("filter-region");
    const sectorEl = document.getElementById("filter-sector");
    const contactEl = document.getElementById("filter-contact");
    const prodChks = Array.from(document.querySelectorAll(".prod-chk"));
    const matchRadios = Array.from(document.querySelectorAll("input[name='match-mode']"));

    function renderCellCheck(val, colorClass) {
      return val === 1
        ? `<span class="inline-flex items-center justify-center w-5 h-5 rounded font-bold text-[11px] ${colorClass}">✔</span>`
        : `<span class="text-slate-300">-</span>`;
    }

    function applyFilters() {
      const q = searchEl.value.toLowerCase().trim();
      const reg = regionEl.value;
      const sec = sectorEl.value;
      const con = contactEl.value;
      const selectedProds = prodChks.filter(c => c.checked).map(c => parseInt(c.value, 10));
      const matchMode = document.querySelector("input[name='match-mode']:checked").value;

      filteredLeads = RAW_LEADS.filter((row) => {
        const [rHub, city, name, addr, sGroup, sDesc, phone, email, p] = row;

        if (reg !== "ALL" && rHub !== reg) return false;
        if (sec !== "ALL" && sGroup !== sec) return false;
        if (con === "EMAIL" && !email.includes("@")) return false;
        if (con === "HOTLINE" && !/\b1[5679]\d{3}\b/.test(phone)) return false;

        if (q) {
          const hay = `${city} ${name} ${addr} ${sGroup} ${sDesc} ${phone} ${email}`.toLowerCase();
          if (!hay.includes(q)) return false;
        }

        if (selectedProds.length > 0) {
          if (matchMode === "ANY") {
            if (!selectedProds.some(idx => p[idx] === 1)) return false;
          } else {
            if (!selectedProds.every(idx => p[idx] === 1)) return false;
          }
        }
        return true;
      });

      renderTable();
      updateKPIs();
    }

    function updateKPIs() {
      document.getElementById("kpi-matching").textContent = filteredLeads.length;
      for (let i = 0; i < 9; i++) {
        const count = filteredLeads.reduce((acc, r) => acc + (r[8][i] === 1 ? 1 : 0), 0);
        document.getElementById(`kpi-p${i}`).textContent = count;
      }
    }

    function renderTable() {
      if (filteredLeads.length === 0) {
        tbody.innerHTML = `<tr><td colspan="16" class="py-10 text-center text-slate-500">No leads match the current filter combination. Click "Reset All Filters" to restore all 184 accounts.</td></tr>`;
        return;
      }

      tbody.innerHTML = filteredLeads.map((row, idx) => {
        const [rHub, city, name, addr, sGroup, sDesc, phone, email, p] = row;
        return `
          <tr class="hover:bg-blue-50/40 cursor-pointer transition" onclick="openModal(${idx})">
            <td class="py-2.5 px-2.5 text-center font-bold text-slate-400">${idx + 1}</td>
            <td class="py-2.5 px-3">
              <div class="font-bold text-slate-800">${city}</div>
              <div class="text-[10px] text-slate-500">${rHub.replace(/^\d+\.\s*/, '')}</div>
            </td>
            <td class="py-2.5 px-3 font-bold text-slate-900">${name}</td>
            <td class="py-2.5 px-3 text-slate-600">${addr}</td>
            <td class="py-2.5 px-3">
              <span class="inline-block px-2 py-0.5 rounded bg-slate-100 text-slate-700 font-semibold text-[10px]">${sGroup}</span>
              <div class="text-[10px] text-slate-500 mt-0.5">${sDesc}</div>
            </td>
            <td class="py-2.5 px-3 font-mono font-semibold text-blue-700">${phone}</td>
            <td class="py-2.5 px-3 font-mono text-[11px] text-slate-700 break-all">${email}</td>
            <td class="py-2.5 px-1.5 text-center">${renderCellCheck(p[0], "bg-pink-100 text-pink-800")}</td>
            <td class="py-2.5 px-1.5 text-center">${renderCellCheck(p[1], "bg-indigo-100 text-indigo-800")}</td>
            <td class="py-2.5 px-1.5 text-center">${renderCellCheck(p[2], "bg-amber-100 text-amber-800")}</td>
            <td class="py-2.5 px-1.5 text-center">${renderCellCheck(p[3], "bg-cyan-100 text-cyan-800")}</td>
            <td class="py-2.5 px-1.5 text-center">${renderCellCheck(p[4], "bg-orange-100 text-orange-800")}</td>
            <td class="py-2.5 px-1.5 text-center">${renderCellCheck(p[5], "bg-blue-100 text-blue-800")}</td>
            <td class="py-2.5 px-1.5 text-center">${renderCellCheck(p[6], "bg-teal-100 text-teal-800")}</td>
            <td class="py-2.5 px-1.5 text-center">${renderCellCheck(p[7], "bg-emerald-100 text-emerald-800")}</td>
            <td class="py-2.5 px-1.5 text-center">${renderCellCheck(p[8], "bg-purple-100 text-purple-800")}</td>
          </tr>
        `;
      }).join("");
    }

    window.openModal = function(idx) {
      const row = filteredLeads[idx];
      if (!row) return;
      const [rHub, city, name, addr, sGroup, sDesc, phone, email, p] = row;
      document.getElementById("m-region").textContent = `${rHub} • ${city}`;
      document.getElementById("m-name").textContent = name;
      document.getElementById("m-sector").textContent = `${sGroup} — ${sDesc}`;
      document.getElementById("m-address").textContent = addr;
      document.getElementById("m-phone").textContent = phone;
      document.getElementById("m-email").textContent = email;

      const prodContainer = document.getElementById("m-products");
      prodContainer.innerHTML = PRODUCT_NAMES.map((pName, i) => {
        if (p[i] === 1) {
          return `<span class="px-2.5 py-1 rounded-md border text-xs font-bold ${PRODUCT_BADGE_COLORS[i]}">✔ ${pName}</span>`;
        }
        return "";
      }).join("");

      const modal = document.getElementById("lead-modal");
      modal.classList.remove("hidden");
      modal.classList.add("flex");
    };

    document.getElementById("m-close").addEventListener("click", () => {
      const modal = document.getElementById("lead-modal");
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    });

    document.getElementById("lead-modal").addEventListener("click", (e) => {
      if (e.target.id === "lead-modal") {
        e.target.classList.add("hidden");
        e.target.classList.remove("flex");
      }
    });

    // Event Listeners
    [searchEl, regionEl, sectorEl, contactEl, ...prodChks, ...matchRadios].forEach(el => {
      el.addEventListener("input", applyFilters);
      el.addEventListener("change", applyFilters);
    });

    document.getElementById("btn-clear-products").addEventListener("click", () => {
      prodChks.forEach(c => c.checked = false);
      applyFilters();
    });

    document.getElementById("btn-reset").addEventListener("click", () => {
      searchEl.value = "";
      regionEl.value = "ALL";
      sectorEl.value = "ALL";
      contactEl.value = "ALL";
      prodChks.forEach(c => c.checked = false);
      matchRadios[0].checked = true;
      applyFilters();
    });

    // CSV Export
    document.getElementById("btn-export").addEventListener("click", () => {
      const headers = [
        "Region Hub", "City / Location", "Company Name", "District / Address",
        "Sector Category", "Primary Sector Description", "Phone / Hotline", "Email / Contact Channel",
        ...PRODUCT_NAMES
      ];
      const csvRows = [headers.join(",")];
      filteredLeads.forEach(r => {
        const [rHub, city, name, addr, sGroup, sDesc, phone, email, p] = r;
        const rowData = [
          `"${rHub}"`, `"${city}"`, `"${name.replace(/"/g, '""')}"`, `"${addr.replace(/"/g, '""')}"`,
          `"${sGroup}"`, `"${sDesc.replace(/"/g, '""')}"`, `"${phone}"`, `"${email.replace(/"/g, '""')}"`,
          ...p.map(v => v === 1 ? "Yes" : "No")
        ];
        csvRows.push(rowData.join(","));
      });
      const blob = new Blob(["\uFEFF" + csvRows.join("\n")], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `Egypt_Packaging_B2B_Leads_${filteredLeads.length}_Accounts.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    // Initial Render
    applyFilters();
  </script>
</body>
</html>
